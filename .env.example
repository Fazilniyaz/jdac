# Jadvix Academy — static frontend. No secrets are required to run or build.
#
# The Apply and Contact forms POST to a stubbed handler by default (no data is
# stored). To wire a real form backend later, set a public endpoint URL below
# and read it in src/lib/forms.ts. A public env var is embedded in the client
# bundle, so NEVER put secret keys here — use a provider that accepts a public
# form endpoint (e.g. Formspree, Basin) or add your own API.

# Public form endpoint (optional). Leave blank to keep the stubbed handler.
NEXT_PUBLIC_FORM_ENDPOINT=

# Public contact details shown on the site (marked TODO in config until confirmed).
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Canonical site URL, used for metadata / sitemap / OG tags.
NEXT_PUBLIC_SITE_URL=https://academy.jadvix.com
